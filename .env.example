# ==============================================================================
# AI-Powered Food Waste Prediction System
# Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate.
# ==============================================================================

# Flask Server Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_secret_key
PORT=5000

# Database Engine Selection
# DB_TYPE options:
#   - 'mysql'  : Primary College Submission database (production standard)
#   - 'sqlite' : Local zero-configuration development database
DB_TYPE=mysql

# Database Failover Governance
# When DB_TYPE=mysql but MySQL cannot be reached:
#   - false (Default): Startup aborts immediately to prevent silent database switching and data loss.
#   - true           : In development mode only, allows controlled fallback to SQLite at SQLITE_PATH.
#   Note: In production (FLASK_ENV=production), fallback is strictly disabled regardless of this setting.
ALLOW_SQLITE_FALLBACK=false

# Direct Database URL Option (Optional: takes precedence over individual DB_* fields)
# Passwords with special characters (@, #, :, /, %, &) will be safely URL-encoded.
# Example MySQL:  DATABASE_URL=mysql+pymysql://root:password@localhost:3306/food_waste_db
# Example SQLite: DATABASE_URL=sqlite:///database/food_waste.db
DATABASE_URL=

# MySQL Connection Details (Active when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=food_waste_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# SQLite Database File Path (Active when DB_TYPE=sqlite or during controlled development fallback)
SQLITE_PATH=database/food_waste.db
